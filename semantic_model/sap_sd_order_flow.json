{
  "model_id": "sap-sd-order-flow",
  "model_version": "2026.09.11.1",
  "domain": "SAP SD order-to-cash",
  "title": "SAP SD 訂單跨文件查詢語意模型",
  "policies": {
    "sap_access": "read_only",
    "allowed_methods": ["GET"],
    "max_pages": 5,
    "timeout_seconds": 30
  },
  "entities": [
    {"id": "sales_order", "label": "銷售訂單", "business_description": "客戶採購需求在 SAP SD 中形成的銷售文件。"},
    {"id": "outbound_delivery", "label": "外向交貨", "business_description": "由銷售訂單履約而產生的出貨文件。"},
    {"id": "billing_document", "label": "請款文件", "business_description": "依訂單或交貨產生的請款文件。"},
    {"id": "customer", "label": "售達方", "business_description": "提出採購需求並接收銷售文件的客戶。"}
  ],
  "relationships": [
    {"id": "sales_order_to_delivery", "from": "sales_order", "to": "outbound_delivery", "business_description": "外向交貨文件履行銷售訂單；以參考 SD 文件號追蹤兩者關聯。"},
    {"id": "sales_order_to_billing", "from": "sales_order", "to": "billing_document", "business_description": "請款文件源自銷售訂單流程；可用原始 SD 文件號追蹤關聯。"}
  ],
  "services": {
    "sales_order_api": {"url_env": "SAP_ODATA_SALES_ORDER_URL", "default_protocol": "odata-v2", "entity_set": "A_SalesOrder"},
    "delivery_api": {"url_env": "SAP_ODATA_DELIVERY_URL", "default_protocol": "odata-v2", "entity_set": "A_OutbDeliveryHeader"},
    "billing_api": {"url_env": "SAP_ODATA_BILLING_URL", "default_protocol": "odata-v2", "entity_set": "A_BillingDocument"}
  },
  "operations": [
    {
      "id": "search_sales_orders",
      "technical_tool_name": "query_A_SalesOrder",
      "entity": "sales_order",
      "method": "GET",
      "read_only_policy": true,
      "typed_description": "Search sales orders with typed filters.",
      "business_description": "依訂單、客戶、建立日期或銷售組織等條件查詢銷售訂單，適合使用者尚未提供唯一訂單號時使用。",
      "relationship_ids": [],
      "parameters": [
        {"name": "sales_order_id", "technical_name": "SalesOrder", "type": "string", "max_length": 10, "pattern": "^[A-Za-z0-9]{1,10}$", "typed_description": "Sales order identifier.", "business_description": "SAP 銷售訂單編號。", "operator": "eq"},
        {"name": "sold_to_party_id", "technical_name": "SoldToParty", "type": "string", "max_length": 10, "pattern": "^[A-Za-z0-9]{1,10}$", "typed_description": "Sold-to party identifier.", "business_description": "售達方客戶編號。", "operator": "eq"},
        {"name": "created_by_user", "technical_name": "CreatedByUser", "type": "string", "max_length": 40, "pattern": "^[A-Za-z0-9._-]{1,40}$", "typed_description": "User that created the order.", "business_description": "建立訂單的 SAP 使用者。", "operator": "eq"},
        {"name": "created_from", "technical_name": "CreationDate", "technical_parameter_name": "CreationDate_ge", "type": "string", "odata_type": "date", "max_length": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "typed_description": "Inclusive start date in YYYY-MM-DD.", "business_description": "訂單建立日期起點，包含該日，格式 YYYY-MM-DD。", "operator": "ge"},
        {"name": "created_to", "technical_name": "CreationDate", "technical_parameter_name": "CreationDate_le", "type": "string", "odata_type": "date", "max_length": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "typed_description": "Inclusive end date in YYYY-MM-DD.", "business_description": "訂單建立日期終點，包含該日，格式 YYYY-MM-DD。", "operator": "le"},
        {"name": "sales_organization", "technical_name": "SalesOrganization", "type": "string", "max_length": 4, "pattern": "^[A-Za-z0-9]{1,4}$", "typed_description": "Sales organization code.", "business_description": "負責銷售訂單的銷售組織代碼。", "operator": "eq"},
        {"name": "distribution_channel", "technical_name": "DistributionChannel", "type": "string", "max_length": 2, "pattern": "^[A-Za-z0-9]{1,2}$", "typed_description": "Distribution channel code.", "business_description": "銷售訂單的配銷通路代碼。", "operator": "eq"},
        {"name": "division", "technical_name": "OrganizationDivision", "type": "string", "max_length": 2, "pattern": "^[A-Za-z0-9]{1,2}$", "typed_description": "Division code.", "business_description": "銷售訂單所屬產品部門代碼。", "operator": "eq"},
        {"name": "sales_order_type", "technical_name": "SalesOrderType", "type": "string", "max_length": 4, "pattern": "^[A-Za-z0-9]{1,4}$", "typed_description": "Sales order type.", "business_description": "銷售訂單類型，例如標準訂單類型。", "operator": "eq"},
        {"name": "customer_reference", "technical_name": "PurchaseOrderByCustomer", "type": "string", "max_length": 35, "pattern": "^[^'\\r\\n]{1,35}$", "typed_description": "Customer purchase-order reference.", "business_description": "客戶提供的採購單或參考編號。", "operator": "eq"},
        {"name": "limit", "technical_name": "$top", "type": "integer", "minimum": 1, "maximum": 50, "typed_description": "Maximum result count.", "business_description": "最多回傳幾筆訂單，範圍為 1 至 50。"}
      ],
      "odata_binding": {"service": "sales_order_api", "method": "GET", "default_top": 20, "select": ["SalesOrder", "SalesOrderType", "SoldToParty", "CreationDate", "SalesOrganization", "DistributionChannel", "OrganizationDivision", "PurchaseOrderByCustomer", "OverallSDProcessStatus"]},
      "output_schema": {"type": "object", "properties": {"row_count": {"type": "integer"}, "rows": {"type": "array", "items": {"type": "object"}}, "protocol": {"type": "string"}}}
    },
    {
      "id": "get_sales_order",
      "technical_tool_name": "read_A_SalesOrder",
      "entity": "sales_order",
      "method": "GET",
      "read_only_policy": true,
      "typed_description": "Get one sales order by its identifier.",
      "business_description": "取得指定銷售訂單的客戶、組織與整體處理狀態，作為後續跨文件追蹤的起點。",
      "relationship_ids": [],
      "parameters": [
        {"name": "sales_order_id", "technical_name": "SalesOrder", "type": "string", "required": true, "max_length": 10, "pattern": "^[A-Za-z0-9]{1,10}$", "typed_description": "Sales order identifier.", "business_description": "要查詢及追蹤的 SAP 銷售訂單編號。", "operator": "eq"}
      ],
      "odata_binding": {"service": "sales_order_api", "method": "GET", "default_top": 1, "select": ["SalesOrder", "SalesOrderType", "SoldToParty", "CreationDate", "SalesOrganization", "DistributionChannel", "OrganizationDivision", "PurchaseOrderByCustomer", "OverallSDProcessStatus"]},
      "output_schema": {"type": "object", "properties": {"row_count": {"type": "integer"}, "rows": {"type": "array", "items": {"type": "object"}}, "protocol": {"type": "string"}}}
    },
    {
      "id": "get_related_deliveries",
      "technical_tool_name": "query_A_OutbDeliveryHeader_by_ReferenceSDDocument",
      "entity": "outbound_delivery",
      "method": "GET",
      "read_only_policy": true,
      "typed_description": "Get outbound deliveries whose reference document is a sales order.",
      "business_description": "依銷售訂單編號查詢其後續外向交貨文件與出貨處理狀態。",
      "relationship_ids": ["sales_order_to_delivery"],
      "parameters": [
        {"name": "sales_order_id", "technical_name": "ReferenceSDDocument", "type": "string", "required": true, "max_length": 10, "pattern": "^[A-Za-z0-9]{1,10}$", "typed_description": "Referenced sales order identifier.", "business_description": "作為交貨文件來源的 SAP 銷售訂單編號。", "operator": "eq"}
      ],
      "odata_binding": {"service": "delivery_api", "method": "GET", "default_top": 20, "select": ["DeliveryDocument", "DeliveryDocumentType", "ReferenceSDDocument", "ShippingPoint", "OverallGoodsMovementStatus", "ActualGoodsMovementDate"]},
      "output_schema": {"type": "object", "properties": {"row_count": {"type": "integer"}, "rows": {"type": "array", "items": {"type": "object"}}, "protocol": {"type": "string"}}}
    },
    {
      "id": "get_related_billing_documents",
      "technical_tool_name": "query_A_BillingDocument_by_SDDocument",
      "entity": "billing_document",
      "method": "GET",
      "read_only_policy": true,
      "typed_description": "Get billing documents whose source SD document is a sales order.",
      "business_description": "依銷售訂單編號查詢其後續請款文件、取消狀態與會計過帳狀態。",
      "relationship_ids": ["sales_order_to_billing"],
      "parameters": [
        {"name": "sales_order_id", "technical_name": "SDDocument", "type": "string", "required": true, "max_length": 10, "pattern": "^[A-Za-z0-9]{1,10}$", "typed_description": "Source sales order identifier.", "business_description": "作為請款流程來源的 SAP 銷售訂單編號。", "operator": "eq"}
      ],
      "odata_binding": {"service": "billing_api", "method": "GET", "default_top": 20, "select": ["BillingDocument", "BillingDocumentType", "SDDocument", "BillingDocumentDate", "CancelledBillingDocument", "AccountingPostingStatus"]},
      "output_schema": {"type": "object", "properties": {"row_count": {"type": "integer"}, "rows": {"type": "array", "items": {"type": "object"}}, "protocol": {"type": "string"}}}
    }
  ]
}

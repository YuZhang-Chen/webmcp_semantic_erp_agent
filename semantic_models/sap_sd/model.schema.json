{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/webmcp/sap-sd/model.schema.json",
  "title": "Governed SAP SD semantic model",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "evidence_policy", "scope_boundary", "semantic_field_inventory", "policies", "formats", "business_fields", "entities", "relationships", "output_schemas", "operations", "bindings"],
  "properties": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "protocol", "source_id", "model_source_id"],
      "properties": {
        "id": {"const": "sap-sd-webmcp"},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "validated"]},
        "protocol": {"const": "odata-v2"},
        "source_id": {"const": "webmcp.sap_sd.odata"},
        "model_source_id": {"const": "webmcp.sap_sd.semantic_model"}
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_mode", "official_release_evidence_id", "product", "release", "software_component", "component_release", "precedence", "status_domain_policy", "code_list_governance"],
      "properties": {
        "validation_mode": {"const": "multi_source"},
        "official_release_evidence_id": {"const": "sap-s4hana-2023-s4core-108"},
        "product": {"const": "SAP S/4HANA"},
        "release": {"const": "2023"},
        "software_component": {"const": "S4CORE"},
        "component_release": {"const": "108"},
        "precedence": {
          "const": ["official_api_definition", "tenant_metadata", "known_case_runtime", "semantic_binding_validation"]
        },
        "status_domain_policy": {"const": "official_complete_tenant_representative"},
        "code_list_governance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_for", "not_required_for"],
          "properties": {
            "required_for": {"const": ["status", "enumeration", "category", "discriminator"]},
            "not_required_for": {"const": ["id", "date", "quantity", "customer"]}
          }
        }
      }
    },
    "scope_boundary": {"$ref": "#/$defs/scope_boundary"},
    "semantic_field_inventory": {"$ref": "#/$defs/semantic_field_inventory"},
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_http_methods", "operation_allowlist", "allow_unverified_bindings", "fallback"],
      "properties": {
        "allowed_http_methods": {"const": ["GET"]},
        "operation_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 4,
          "maxItems": 4,
          "items": {"enum": ["search_sales_orders", "get_sales_order", "get_related_deliveries", "get_related_billing_documents"]}
        },
        "allow_unverified_bindings": {"const": false},
        "fallback": {"const": "forbidden"}
      }
    },
    "formats": {"type": "object", "additionalProperties": {"type": "object"}},
    "business_fields": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "propertyNames": {
        "enum": ["delivery_date", "delivery_status", "billing_date", "billing_status"]
      },
      "additionalProperties": {"$ref": "#/$defs/business_field"}
    },
    "entities": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {"$ref": "#/$defs/entity"}
    },
    "relationships": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {"$ref": "#/$defs/relationship"}
    },
    "output_schemas": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {"type": "object"}
    },
    "operations": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "additionalProperties": {"$ref": "#/$defs/operation"}
    },
    "bindings": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {"$ref": "#/$defs/binding"}
    }
  },
  "$defs": {
    "scope_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "in_scope", "out_of_scope"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "in_scope": {"type": "array", "uniqueItems": true, "items": {"enum": ["sales_order", "outbound_delivery", "billing_document", "document_flow"]}},
        "out_of_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "semantic_inventory_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "business_concept", "sap_property", "code_list_required"],
      "properties": {
        "field_id": {"type": "string", "minLength": 1},
        "business_concept": {"type": "string", "minLength": 1},
        "sap_property": {"type": "string", "minLength": 1},
        "code_list_required": {"type": "boolean"}
      }
    },
    "semantic_field_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sales_order", "outbound_delivery", "billing_document", "document_flow"],
      "properties": {
        "sales_order": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/semantic_inventory_item"}},
        "outbound_delivery": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/semantic_inventory_item"}},
        "billing_document": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/semantic_inventory_item"}},
        "document_flow": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/semantic_inventory_item"}}
      }
    },
    "business_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_definition", "candidate_property", "binding_status"],
      "properties": {
        "business_definition": {"type": "string", "minLength": 1},
        "candidate_property": {"type": "string", "minLength": 1},
        "binding_status": {"enum": ["tenant_verified", "partially_verified", "unverified"]}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_name", "description"],
      "properties": {
        "business_name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "predicate", "target", "description", "operations"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "operations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "method", "entity_refs", "relationship_refs", "input_schema", "output_schema_ref", "binding_ref"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "method": {"const": "GET"},
        "entity_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "relationship_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "input_schema": {"type": "object"},
        "output_schema_ref": {"type": "string", "minLength": 1},
        "binding_ref": {"type": "string", "minLength": 1}
      }
    },
    "field_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "status"],
      "properties": {
        "property": {"type": ["string", "null"]},
        "status": {"enum": ["tenant_verified", "partially_verified", "unverified"]},
        "edm_type": {"type": ["string", "null"]},
        "max_length": {"type": ["integer", "null"], "minimum": 1},
        "code_map": {"type": ["object", "null"], "additionalProperties": {"type": "string"}},
        "code_map_status": {"enum": ["official_documented", "tenant_verified", "partially_verified", "unverified"]},
        "tenant_observed_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "business_value": {"type": "string", "minLength": 1},
        "step_ref": {"type": ["string", "null"]}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "method", "entity_set", "query_strategy", "status", "source_evidence_id", "metadata_sha256", "parameters", "output_fields"],
      "properties": {
        "service_id": {"type": "string", "minLength": 1},
        "method": {"const": "GET"},
        "entity_set": {"type": ["string", "null"]},
        "query_strategy": {"enum": ["collection_filter", "unique_filter", "navigation_collection", null]},
        "status": {"enum": ["tenant_verified", "partially_verified", "unverified"]},
        "source_evidence_id": {"type": "string", "minLength": 1},
        "metadata_sha256": {"type": ["string", "null"]},
        "enrichment": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/enrichment"}
          ]
        },
        "discriminator": {
          "oneOf": [
            {"type": "null"},
            {
              "allOf": [
                {"$ref": "#/$defs/field_binding"},
                {
                  "type": "object",
                  "properties": {
                    "business_value": {"type": "string", "minLength": 1}
                  }
                }
              ]
            }
          ]
        },
        "parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/field_binding"}},
        "output_fields": {"type": "object", "additionalProperties": {"$ref": "#/$defs/field_binding"}}
      }
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "method", "entity_set", "query_strategy", "status", "source_evidence_id", "metadata_sha256", "key_property", "input_field", "evidence_scope"],
      "properties": {
        "service_id": {"type": "string", "minLength": 1},
        "method": {"const": "GET"},
        "entity_set": {"type": "string", "minLength": 1},
        "query_strategy": {"const": "unique_filter"},
        "status": {"enum": ["tenant_verified", "partially_verified", "unverified"]},
        "source_evidence_id": {"type": "string", "minLength": 1},
        "metadata_sha256": {"type": ["string", "null"]},
        "key_property": {"type": "string", "minLength": 1},
        "input_field": {"type": "string", "minLength": 1},
        "evidence_scope": {"enum": ["delivery", "billing"]}
      }
    }
  }
}

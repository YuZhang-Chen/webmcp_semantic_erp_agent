SAP_USER=your_username
SAP_PASSWORD=your_password
SAP_CLIENT=600
SAP_LANGUAGE=ZF
# Sales Order V2 service selector; the probe appends API_SALES_ORDER_SRV when needed.
SAP_ODATA_BASE_URL=
# Field probe selectors. Each must be the complete HTTPS V2 service root;
# leave blank in this template and set tenant-specific values only in .env.
SAP_DELIVERY_ODATA_BASE_URL=
SAP_BILLING_ODATA_BASE_URL=
SAP_ODATA_CA_CERT=
SAP_ODATA_CERT_SHA256=
HMAC_KEY=

# Headless A/B/C Agent provider. Azure OpenAI Responses API v1 is the
# experiment default. Keep secrets only in .env; never commit real values.
AI_PROVIDER=azure_openai
AZURE_OPENAI_API_KEY=
# Resource root only, for example: https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# Azure deployment name for the GPT-5.6 Sol deployment. Azure allows this
# name to differ from the underlying model ID.
AZURE_OPENAI_DEPLOYMENT_NAME=
# Responses API v1 uses /openai/v1 and does not require api-version.
# Keep this blank unless a legacy Azure deployment explicitly requires it.
AZURE_OPENAI_API_VERSION=

# Optional standard OpenAI-compatible provider settings.
OPENAI_API_KEY=
OPENAI_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses
# Underlying model ID pinned in the experiment manifest; keep identical for
# A/B/C even when AZURE_OPENAI_DEPLOYMENT_NAME uses a custom name.
HEADLESS_AGENT_MODEL=gpt-5.6-sol
